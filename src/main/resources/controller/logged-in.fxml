<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="838.0" prefWidth="1311.0" style="-fx-background-color: #2f3640; -fx-border-color: #000;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoggedInController">
    <center>
        <SplitPane dividerPositions="0.55" prefHeight="714.0" BorderPane.alignment="CENTER">
            <items>
                <AnchorPane fx:id="maindash" prefHeight="759.0" prefWidth="445.0" style="-fx-border-color: #000; -fx-background-color: #a5b1c2;">
                    <padding>
                        <Insets top="60.0" />
                    </padding>
                    <children>
                        <Pane layoutX="510.0" layoutY="213.0" prefHeight="200.0" prefWidth="200.0" />
                    </children>
                </AnchorPane>

                <VBox fx:id="receiptViewPane" minWidth="300.0" prefHeight="759.0" prefWidth="150.0" style="-fx-background-color: #f5f5f5; -fx-border-color: #aaa;">
                    <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #465060; -fx-border-color: #000; -fx-text-fill: white;" text="Receipt" VBox.vgrow="NEVER">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                            <padding>
                                <Insets bottom="8.0" top="8.0" />
                            </padding>
                        </Label>
                        <TextArea fx:id="receiptTextArea" editable="false" prefHeight="685.0" prefWidth="180.0" style="-fx-font-family: 'Consolas'; -fx-font-size: 10pt; -fx-background-color: white; -fx-border-color: #000;" wrapText="true" VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #dcdcdc; -fx-border-color: #aaa;">
                            <padding>
                                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                            </padding>
                            <Label text="Transaction ID: " />
                            <Label fx:id="receiptTransactionIdLabel" text="[TID]" />
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <right>
        <VBox prefHeight="701.0" prefWidth="350.0" style="-fx-background-color: #dcdcdc; -fx-border-color: #000;" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="orderview" prefHeight="753.0" prefWidth="392.0" style="-fx-background-color: #a4b0be;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="viewName" prefWidth="150.0" text="Name" />
                        <TableColumn fx:id="viewPrice" prefWidth="70.0" text="Price" />
                        <TableColumn fx:id="viewQuantity" prefWidth="70.0" text="Quantity" />
                        <TableColumn fx:id="viewTotal" prefWidth="70.0" text="Total" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Total Price Display -->
                <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="10.0" style="-fx-background-color: #808e9b; -fx-border-color: #000;">
                    <children>
                        <Label text="TOTAL:" textFill="#2600ff">
                            <font>
                                <Font name="Consolas Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="totalPrice" text="₱0.00" textFill="#2600ff">
                            <font>
                                <Font name="Consolas Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets right="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </right>
    <bottom>
        <!-- Function Key Buttons -->
        <HBox alignment="CENTER" prefHeight="65.0" spacing="12.0" style="-fx-background-color: #747d8c; -fx-border-color: #000;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="button_new_order" mnemonicParsing="false" onAction="#handleNewOrder" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F1 - New Order" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_payment" mnemonicParsing="false" onAction="#handlePayment" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F2 - Payment " textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_cancel_order" mnemonicParsing="false" onAction="#handleCancelOrder" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F3 - Cancel Order" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_product_manage" mnemonicParsing="false" onAction="#manageProduct" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F4 - Manage Product" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_manage" mnemonicParsing="false" onAction="#manageTable" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F5 - Manage Category" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_sales_report" mnemonicParsing="false" onAction="#handleSalesReport" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F6 - Sales Report" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_logout" mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" text="F7 - Logout" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </HBox>
    </bottom>
    <left>
        <!-- Category Buttons -->
        <VBox prefHeight="753.0" prefWidth="214.0" spacing="10.0" style="-fx-background-color: #57606f; -fx-border-color: #000;" BorderPane.alignment="CENTER">
            <children>
                <Pane prefHeight="40.0" prefWidth="193.0" style="-fx-border-color: #000;">
                    <children>
                        <Label fx:id="orderID" layoutX="6.0" layoutY="6.0" text="ID00" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <Label fx:id="orderDate" layoutX="6.0" layoutY="20.0" text="mm/dd/yyyy" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>
                <Button fx:id="button_display" lineSpacing="20.0" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDisplays" prefHeight="40.0" style="-fx-background-color: #747d8c; -fx-border-color: #000;" text="Displays/Monitor" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_com" lineSpacing="20.0" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCom" prefHeight="40.0" style="-fx-background-color: #747d8c; -fx-border-color: #000;" text="Computer Peripherals" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_audio" lineSpacing="20.0" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAudio" prefHeight="40.0" style="-fx-background-color: #747d8c; -fx-border-color: #000;" text="Audio Devices" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="button_cables" lineSpacing="20.0" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCables" prefHeight="40.0" style="-fx-background-color: #747d8c; -fx-border-color: #000;" text="Cables" textFill="WHITE">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </left>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>
</BorderPane>
